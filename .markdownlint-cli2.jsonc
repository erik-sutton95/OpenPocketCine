{
  // Rule overrides.
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD041": false,
    // Keep a Changelog repeats Added/Fixed/Changed per version.
    "MD024": { "siblings_only": true },
    // Protocol tables are compact on purpose; don't fight pipe spacing.
    "MD060": false
  },
  // Don't lint proprietary dirs, internal planning artifacts (planning docs embed
  // nested code fences on purpose), or skill reference material (dense protocol
  // tables in their own compact format).
  "ignores": [
    "vendor/**",
    "ref/**",
    ".local/**",
    ".planning/**",
    "STATUS.md",
    "OVERNIGHT.md",
    ".claude/skills/**",
    // graphify knowledge-graph output is regenerated locally; never committed.
    "graphify-out/**",
    // Worktree checkouts (agent sessions) are full repo copies — linted in their
    // own checkout, not the parent's.
    ".claude/worktrees/**",
    ".worktrees/**",
    "docs/design/**",
    "docs/protocol-notes.md",
    "handbook/dist/**",
    "handbook/.astro/**",
    "handbook/node_modules/**",
    "docs/capture-guide.md",
    "ios/**",
    "android/**",
    "build/**",
    // SwiftPM dependency checkouts and build products.
    ".build/**",
    "**/node_modules/**"
  ]
}
