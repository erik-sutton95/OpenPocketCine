# ── Local-only material (see docs/commit-hygiene.md) ────────────────────────
# Anything vendor-proprietary or otherwise non-redistributable stays local.
# NEVER commit these.
vendor/
ref/
# TestFlight / App Store Connect feedback dumps (screenshots + random IDs).
feedback/

# ── Secrets & credentials (see docs/commit-hygiene.md) ─────────────────────────
.env
.env.*
!.env.example
secrets.*
*.secret
# Private keys, certificates, signing material
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
*.cer
*.der
*.certSigningRequest
# Apple provisioning profiles
*.mobileprovision
*.provisionprofile
# Cloud / service-account credential files
google-services.json
GoogleService-Info.plist
*credentials*.json
service-account*.json
# Local Frame.io OAuth config (PKCE client ID)
ios/OpenPocketCine/Frameio.local.xcconfig
# Android SDK path — machine-specific
Apps/Android/local.properties

# ── Reverse-engineering captures (keep out of the public repo) ────────────────
captures/
*.pcap
*.pcapng
*.btsnoop

# ── LUT dumps that are not the bundled official looks ─────────────────────────
# Official Rec.709 cubes in ios/OpenPocketCine/Resources/ are redistributable
# and tracked. Unofficial copies (spaces, "vivid", duplicates) stay local.
*.cube
!Tests/**/*.cube
!ios/OpenPocketCine/Resources/*.cube
Osmo LUTS/

# Raw design-source files are kept under .local/ and never shipped.
*.psd
*.psb
# Working app-icon source at the repo root. Runtime copies live in Assets.xcassets.
/OpenPocketCine Icon.png

# ── Supported agent tooling scratch space ─────────────────────────────────────
.local/
.codex/
.planning/
STATUS.md
OVERNIGHT.md

# ── Generated knowledge-graph output (graphify CLI) ───────────────────────────
graphify-out/

# ── OS / editor junk ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.swp
*.swo
*~

# ── Build artifacts ───────────────────────────────────────────────────────────
.build/
build/
DerivedData/
.wrangler/

# Xcode / SwiftPM per-user state
.swiftpm/
**/xcuserdata/
*.xcuserstate

# Generated by xcodegen from ios/project.yml
ios/OpenPocketView.xcodeproj/
ios/OpenPocketCine.xcodeproj/

# Protocol handbook (Astro Starlight)
handbook/node_modules/
handbook/dist/
handbook/.astro/

# Python
__pycache__/
*.pyc
.venv/

# Android
.gradle/
**/android/.gradle/
Apps/Android/.gradle/
Apps/Android/.kotlin/
Apps/Android/build/
Apps/Android/app/build/
Apps/Android/core-api/build/
Apps/Android/app/.cxx/
# Cross-compiled Swift core .so set staged by `just android-core`
Apps/Android/app/src/main/jniLibs/

# ── Retired agent clients ──────────────────────────────────────────────────────
